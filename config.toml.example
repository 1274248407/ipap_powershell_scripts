# config.toml.example - IPAP Workflow 项目配置模板
# 复制此文件并重命名为 config.toml，然后根据您的环境修改配置

# --- [paths] - 路径配置 ---
[paths]
# 漫画/翻译项目工作区的基准目录 (请根据实际环境修改)
base_project_dir = "D:/documents/translation/01_Projects_Active"
# 源图片目录（待处理的漫画图片所在目录）
# 提示：Windows 路径建议用单引号字面量字符串，例如：
# source_dir = 'C:\Users\Name\Pictures\Manga'
# 若使用双引号，必须将反斜杠转义为双反斜杠，例如：
# source_dir = "C:\\Users\\Name\\Pictures\\Manga"
source_dir = ''
# FFmpeg/FFprobe 可执行文件路径（相对于项目根目录）
ffmpeg_exe = "bin/ffmpeg-xxx/bin/ffmpeg.exe"
ffprobe_exe = "bin/ffmpeg-xxx/bin/ffprobe.exe"
# Real-CUGAN 可执行文件路径（相对于项目根目录）
realcugan_exe = "bin/realcugan-ncnn-vulkan-xxx/realcugan-ncnn-vulkan.exe"


# --- [project] - 项目信息配置 ---
[project]
# 作者名（用于生成项目目录名和 README）
author = "作者名"
# 原作品名（原文）
original_title = "原作品名"
# 作品中文译名
chinese_title = "中文译名"
# 原文简介（使用多行字符串，按需求修改）
# 多行字符串使用三个双引号包裹，支持换行
original_overview = """
这是原文简介的第一行。
这是原文简介的第二行。
"""
# 中文简介（使用多行字符串，按需求修改）
chinese_overview = """
这是中文简介的第一行。
这是中文简介的第二行。
"""


# --- [app_settings] - 业务参数 ---
[app_settings]
# 支持的图片格式
supported_image_formats = [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp"]
# 高清化后单张图片大小的上限目标（MB）
# max_output_image_size_mb = 5 （暂时不要）
# 并行处理高清化任务的最大进程数 (0 表示由程序根据 CPU 核心数动态计算，默认为核心数/2)
max_workers = 0
# 高清化超时时间（秒）暂时不知道是单张还是整个任务，所以暂时用3600秒
upscale_timeout_sec = 3600
# 模型选择，默认为"models-se"，可选"models-se"或"models-pro"
model_select = "models-se"

# --- [upscale] - 高清化配置 ---
[upscale]
# 放大倍数，可选值：2, 3, 4
upscale_ratio = 2
# 降噪级别，可选值：0, 1, 2, 3
noise_level = 0

# --- [webp] - WebP 转换配置 ---
[webp]
# 是否启用 WebP 转换
enabled = true
# 是否使用无损压缩
lossless = true
# 压缩质量 (0-100)，仅在非无损模式下有效
quality = 100

# --- [ai] - 中文译名/简介自动补全（可选，默认关闭）---
[ai]
# OpenAI 兼容的 chat completions 地址；留空即不启用，不影响其他功能
# 例：https://api.deepseek.com/v1/chat/completions
endpoint = ""
# 模型名，例：deepseek-chat
model = ""
# API Key 从这个环境变量读取（推荐；优先级高于下一行的 api_key）
api_key_env = "IPAP_AI_API_KEY"
# 备用：直接写在 config.toml 里的密钥。环境变量有值时以环境变量为准。
# ⚠ 只能写在 config.toml（已被 .gitignore 忽略），绝不能写进本模板文件——
#   本文件会随仓库和发布包公开，填进来的密钥等于公开发布。
api_key = ""
# 单次请求超时（秒）
timeout_sec = 30

# --- [classifier] - 图片分级阈值 ---
[classifier]
# 高细节阈值（边缘图 PNG 大小，KB）：长边 >= 1920 且 YDIF >= 该值判为 Level 0（跳过）
high_detail = 6.0
# 中细节阈值（KB）：长边 >= 1100 或 YDIF >= 该值判为 Level 1（FFmpeg）
medium_detail = 3.0
