{
  "$schema": "https://opencode.ai/config.json",

  // Shell 使用 PowerShell 7（与项目 PS7 强制规则一致）
  "shell": "pwsh",

  // 权限护栏：高危操作先询问
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "*build.ps1* -Task Release*", "effect": "ask" },
    { "action": "edit", "resource": "config.toml", "effect": "ask" }
  ],

  // 忽略构建产物与二进制目录的文件监听
  "watcher": {
    "ignore": ["output/**", "bin/**", "coverage.xml", "*.log", "*.tmp"]
  }
}
